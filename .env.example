# FLUXA Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
DATABASE_PATH=instance/fluxa.db

# AI Provider Configuration (anthropic | openrouter | mock)
AI_PROVIDER=mock

# Anthropic (Claude) Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# OpenRouter Configuration (fallback & dev)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODEL=baidu/ernie-5.5-flash-preview:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Live web search for research (free tiers). Tavily is tried first, then Brave.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
RESEARCH_MAX_TOOL_STEPS=8
# auto = live web research only when TAVILY_API_KEY or BRAVE_SEARCH_API_KEY is set (saves free AI quota); on / off to force
RESEARCH_LIVE=auto

# Google Gemini free tier (aistudio.google.com). Used as a second free backend after the
# main OpenRouter model, so the daily free limits of both add up.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=

# Extra browser origins allowed to make changes (comma-separated). Default: the Vite dev server.
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set SECRET_KEY on any shared or deployed server, and SESSION_COOKIE_SECURE=True behind HTTPS.
SECRET_KEY=
SESSION_COOKIE_SECURE=False

# Background jobs (F12): run the job worker inside the web process (0 = off), and how many jobs at once.
JOBS_WORKER=1
JOBS_CONCURRENCY=2

# Extra AI fact-check pass after slides are written (adds ~35 s per deck). Numbers are always verified in code.
DECK_FACT_CHECK=off
